+bool Window::normalize_pointer(float x, float y, float& nx, float& ny) const noexcept {
+    struct Request { SDL_Window* window; int w = 0, h = 0; } request{window_};
+    auto read_size = [](void* data) {
+        auto& r = *static_cast<Request*>(data);
+        if (r.window) SDL_GetWindowSize(r.window, &r.w, &r.h);
+    };
+    if (threaded_ && !SDL_IsMainThread()) {
+        if (!SDL_RunOnMainThread(read_size, &request, true)) return false;
+    } else read_size(&request);
+    if (request.w <= 0 || request.h <= 0) return false;
+    nx = x / static_cast<float>(request.w); ny = y / static_cast<float>(request.h);
+    return true;
+}
