+    // Counter pixels are independent of the internal render resolution. Only this
+    // small transparent image is uploaded; the game image stays on the GPU.
+    void upload_counter(VkCommandBuffer cmd) {
+        const auto extent = window.extent();
+        const std::uint32_t w = 640;
+        const std::uint32_t h = std::max(1u, static_cast<std::uint32_t>(
+            static_cast<std::uint64_t>(w) * extent.height / std::max(1u, extent.width)));
+        char line[64];
+        std::snprintf(line, sizeof line, "%.1f FPS  %.2fX", fps_shown, speed_shown);
+        if (counter_h == h && counter_text == line) return;
+        counter_pixels.assign(static_cast<std::size_t>(w) * h, 0);
+        draw_counter(counter_pixels.data(), w, h);
+        if (counter_presenter.upload(cmd, counter_pixels.data(), w, h)) {
+            counter_h = h;
+            counter_text = line;
+        }
+    }
