+int MenuUi::slider_value(const std::string& key) const {
+    if (key != "mouse_sensitivity") return std::clamp(draft_.get_int(key, 100), 0, 100);
+    char* end = nullptr;
+    const auto text = draft_.get(key, "0.12");
+    float value = std::strtof(text.c_str(), &end);
+    if (!end || *end || !std::isfinite(value)) value = 0.12f;
+    return static_cast<int>(std::lround(std::clamp(value / 0.0024f, 1.0f, 100.0f)));
+}
+
+void MenuUi::set_slider_value(const std::string& key, int percent) {
+    if (key == "mouse_sensitivity")
+        draft_.set(key, std::to_string(static_cast<float>(std::clamp(percent, 1, 100)) * 0.0024f));
+    else
+        draft_.set(key, std::to_string(std::clamp(percent, 0, 100)));
+}
