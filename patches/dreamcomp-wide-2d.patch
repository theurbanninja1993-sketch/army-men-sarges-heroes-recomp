+bool pillarbox_2d(dream::render::Frame& frame, float aspect) {
+    if (aspect <= 4.0f / 3.0f + 0.001f || frame.vertices.empty()) return false;
+    for (const auto& list : frame.lists)
+        for (const auto& p : list) {
+            if (p.count < 3) continue;
+            const float z = frame.vertices[p.first].z;
+            for (std::uint32_t i = 1; i < p.count; ++i)
+                if (std::abs(frame.vertices[p.first + i].z - z) >
+                    std::max(1e-6f, std::abs(z) * 1e-5f)) return false;
+        }
+    const float scale = (4.0f / 3.0f) / aspect;
+    for (auto& v : frame.vertices) v.x = 320.0f + (v.x - 320.0f) * scale;
+    // The hardware background plane extends past the screen edges. Cover the margins
+    // after all 2D draws instead of cropping that plane's texture coordinates.
+    const float left = 320.0f * (1.0f - scale);
+    for (auto bounds : {std::pair{0.0f, left}, std::pair{640.0f - left, 640.0f}}) {
+        dream::render::Polygon bar;
+        bar.first = static_cast<std::uint32_t>(frame.vertices.size());
+        bar.count = 4;
+        bar.isp = (7u << 29) | (1u << 26);  // depth always, no depth writes or culling
+        bar.tsp = (1u << 29) | (2u << 22);  // source one, destination zero, no fog
+        for (auto point : {std::pair{bounds.first, 0.0f}, std::pair{bounds.second, 0.0f},
+                           std::pair{bounds.first, 480.0f}, std::pair{bounds.second, 480.0f}}) {
+            dream::render::Vertex v;
+            v.x = point.first;
+            v.y = point.second;
+            v.z = 100000.0f;
+            v.base = 0xff000000u;
+            frame.vertices.push_back(v);
+        }
+        frame.lists[2].push_back(bar);
+    }
+    frame.max_z = std::max(frame.max_z, 100000.0f);
+    return true;
+}
 
