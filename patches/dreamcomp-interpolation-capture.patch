+    bool screenshot_interpolated_to(const std::string& name) {
+        // A camera cut or a failed render must not export an old inserted image
+        // beside a newer native frame. Both images must describe the same render.
+        if (!interp_current || !from_renderer)
+            return false;
+        const std::uint32_t* src = interp_off.pixels();
+        if (!src)
+            return false;
+        FILE* f = std::fopen(name.c_str(), "wb");
+        if (!f)
+            return false;
+        std::fprintf(f, "P6\n%u %u\n255\n", interp_off.width(), interp_off.height());
+        const std::size_t n = static_cast<std::size_t>(interp_off.width()) * interp_off.height();
+        for (std::size_t i = 0; i < n; ++i) {
+            const unsigned char rgb[3] = {static_cast<unsigned char>(src[i]),
+                                          static_cast<unsigned char>(src[i] >> 8),
+                                          static_cast<unsigned char>(src[i] >> 16)};
+            std::fwrite(rgb, 1, 3, f);
+        }
+        std::fclose(f);
+        return true;
     }
 
